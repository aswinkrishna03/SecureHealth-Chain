# ==============================================================================
# SECUREHEALTH CHAIN: ENVIRONMENT CONFIGURATION
# ==============================================================================

# MySQL Database Configuration
# If using XAMPP: MYSQL_USER is 'root' and MYSQL_PASSWORD is empty ''
# If using MySQL Workbench / Server: Set MYSQL_PASSWORD to your root password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=securehealth_db

# Ethereum Blockchain Configuration (Ganache / Sepolia)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Platform Server Port
PORT=5000
